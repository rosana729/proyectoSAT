# Variables de entorno para SAT Project
# Copiar este archivo como .env y completar con valores reales

# ============================================================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================================================
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# ============================================================================
# CONFIGURACIÓN DE SUPABASE
# ============================================================================
# URL de tu proyecto Supabase (ejemplo: https://abcdefghijklmnop.supabase.co)
SUPABASE_URL=your_supabase_project_url_here

# Clave anónima (se puede exponer al cliente)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Clave de rol de servicio (SECRETO - no exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================================================
# CONFIGURACIÓN DE AUTENTICACIÓN Y SESIONES
# ============================================================================
# Secreto para firmar sesiones (DEBE ser aleatorio y seguro en producción)
SESSION_SECRET=your_super_secret_session_key_here_change_in_production

# Configuración de bcrypt para hash de contraseñas
BCRYPT_ROUNDS=12

# Duración de sesiones en milisegundos (86400000 = 24 horas)
SESSION_MAX_AGE=86400000

# Nombre de la cookie de sesión
SESSION_NAME=sat-session

# ============================================================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================================================
# Modo de base de datos: development, production
DATABASE_MODE=development

# Pool de conexiones (para optimización)
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================================================
# CONFIGURACIÓN DE ARCHIVOS Y UPLOADS
# ============================================================================
# Tamaño máximo de archivos en bytes (10MB = 10485760)
MAX_FILE_SIZE=10485760

# Tipos de archivos permitidos para uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Directorio para almacenar uploads temporales
UPLOAD_DIR=./uploads

# ============================================================================
# CONFIGURACIÓN DE EMAIL (Para notificaciones)
# ============================================================================
# Configuración SMTP (opcional, para envío de emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Email del remitente por defecto
FROM_EMAIL=noreply@sat-sistema.com
FROM_NAME=Sistema SAT

# ============================================================================
# CONFIGURACIÓN DE LOGS
# ============================================================================
# Nivel de logs: error, warn, info, debug
LOG_LEVEL=info

# Directorio para archivos de log
LOG_DIR=./logs

# ============================================================================
# CONFIGURACIÓN DE SEGURIDAD
# ============================================================================
# Rate limiting (requests per minute)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS configuración
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# ============================================================================
# CONFIGURACIÓN DE FUNCIONALIDADES
# ============================================================================
# Habilitar registro de nuevos usuarios
ENABLE_USER_REGISTRATION=true

# Habilitar modo de mantenimiento
MAINTENANCE_MODE=false

# Versión de la aplicación
APP_VERSION=1.0.0

# ============================================================================
# CONFIGURACIÓN DE DESARROLLO (Solo para desarrollo)
# ============================================================================
# Mostrar errores detallados en desarrollo
SHOW_DETAILED_ERRORS=true

# Habilitar recarga automática
ENABLE_HOT_RELOAD=true

# Datos de prueba para desarrollo
DEMO_MODE=true