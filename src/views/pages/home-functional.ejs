<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'SAT - Sistema de Alerta Temprana' %></title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1e40af;
            --secondary: #10b981;
            --success: #059669;
            --danger: #ef4444;
            --warning: #f59e0b;
            --dark: #1f2937;
            --gray: #6b7280;
            --light-gray: #f8fafc;
            --white: #ffffff;
            --gradient-1: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --gradient-2: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            --gradient-3: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            --gradient-orange: linear-gradient(135deg, #ff7b54 0%, #ff6b6b 100%);
            --gradient-green: linear-gradient(135deg, #56ccf2 0%, #2f80ed 100%);
            --gradient-purple: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            line-height: 1.6;
            color: var(--dark);
            background: var(--light-gray);
            overflow-x: hidden;
        }

        /* Navegación */
        .navbar {
            background: rgba(255, 255, 255, 0.98) !important;
            backdrop-filter: blur(20px);
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
            transition: all 0.3s ease;
        }

        .navbar-brand {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--primary) !important;
            text-shadow: 0 2px 4px rgba(37, 99, 235, 0.1);
        }

        .navbar-nav .nav-link {
            font-weight: 500;
            color: var(--dark) !important;
            margin: 0 0.5rem;
            transition: all 0.3s ease;
            position: relative;
        }

        .navbar-nav .nav-link:hover {
            color: var(--primary) !important;
            transform: translateY(-1px);
        }

        .navbar-nav .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: 0;
            left: 50%;
            background-color: var(--primary);
            transition: all 0.3s ease;
        }

        .navbar-nav .nav-link:hover::after {
            width: 100%;
            left: 0;
        }

        /* Hero Section */
        .hero {
            background: var(--gradient-1);
            color: white;
            padding: 8rem 0 6rem;
            position: relative;
            min-height: 100vh;
        }

        /* Mobile responsive improvements */
        @media (max-width: 768px) {
            .hero {
                padding: 6rem 0 4rem;
                min-height: 90vh;
            }
            
            .navbar-brand {
                font-size: 1.4rem;
            }
            
            .navbar-nav .nav-link {
                margin: 0.2rem 0;
                text-align: center;
            }
            
            .hero h1 {
                font-size: 2.5rem !important;
                line-height: 1.2;
            }
            
            .hero .lead {
                font-size: 1.1rem !important;
            }
            
            .btn-lg {
                padding: 0.75rem 2rem !important;
                font-size: 1rem !important;
            }
        }

        @media (max-width: 576px) {
            .hero {
                padding: 5rem 0 3rem;
            }
            
            .hero h1 {
                font-size: 2rem !important;
            }
            
            .hero .lead {
                font-size: 1rem !important;
            }
            
            .container {
                padding-left: 1rem;
                padding-right: 1rem;
            }
        }
            overflow: hidden;
            margin-top: 76px;
        }

        .hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg width="60" height="60" xmlns="http://www.w3.org/2000/svg"><circle cx="30" cy="30" r="1.5" fill="rgba(255,255,255,0.1)"/></svg>');
            opacity: 0.4;
        }

        .hero::after {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            animation: float 6s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(180deg); }
        }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .hero h1 {
            font-size: 3.5rem;
            font-weight: 800;
            margin-bottom: 1.5rem;
            text-shadow: 0 4px 8px rgba(0,0,0,0.1);
            animation: fadeInUp 1s ease-out;
        }

        .hero p.lead {
            font-size: 1.3rem;
            margin-bottom: 2.5rem;
            opacity: 0.95;
            animation: fadeInUp 1s ease-out 0.2s both;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .btn-custom {
            padding: 1rem 2.5rem;
            border-radius: 12px;
            font-weight: 600;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            margin: 0.5rem;
            border: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

        .btn-primary-custom {
            background: var(--white);
            color: var(--primary);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }

        .btn-primary-custom:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            color: var(--primary);
        }

        .btn-secondary-custom {
            background: transparent;
            color: white;
            border: 2px solid rgba(255,255,255,0.8);
            backdrop-filter: blur(10px);
        }

        .btn-secondary-custom:hover {
            background: rgba(255,255,255,0.1);
            border-color: white;
            transform: translateY(-3px);
            color: white;
        }

        /* Estadísticas */
        .stats-section {
            background: white;
            padding: 4rem 0;
            margin-top: -3rem;
            position: relative;
            z-index: 3;
        }

        .stat-card {
            text-align: center;
            padding: 2rem 1rem;
            border-radius: 16px;
            background: linear-gradient(135deg, #f8fafc 0%, #ffffff 100%);
            box-shadow: 0 8px 25px rgba(0,0,0,0.05);
            transition: all 0.3s ease;
            margin-bottom: 2rem;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        }

        .stat-number {
            font-size: 3rem;
            font-weight: 800;
            color: var(--primary);
            display: block;
            margin-bottom: 0.5rem;
        }

        .stat-label {
            color: var(--gray);
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.9rem;
        }

        /* Mobile responsive for stats */
        @media (max-width: 768px) {
            .stats-section {
                padding: 2rem 0;
                margin-top: -2rem;
            }
            
            .stat-card {
                padding: 1.5rem 1rem;
                margin-bottom: 1.5rem;
            }
            
            .stat-number {
                font-size: 2.5rem;
            }
            
            .stat-label {
                font-size: 0.8rem;
            }
        }

        /* Secciones */
        .section {
            padding: 5rem 0;
        }

        @media (max-width: 768px) {
            .section {
                padding: 3rem 0;
            }
        }

        .section-title {
            text-align: center;
            margin-bottom: 4rem;
        }

        .section-title h2 {
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--dark);
            margin-bottom: 1rem;
        }

        .section-title p {
            font-size: 1.2rem;
            color: var(--gray);
            max-width: 600px;
            margin: 0 auto;
        }

        /* Cards de funcionalidades */
        .feature-card {
            background: white;
            border-radius: 20px;
            padding: 2.5rem;
            box-shadow: 0 8px 30px rgba(0,0,0,0.08);
            transition: all 0.3s ease;
            border: 1px solid rgba(37, 99, 235, 0.1);
            height: 100%;
            position: relative;
            overflow: hidden;
            margin-bottom: 2rem;
        }

        .feature-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--gradient-1);
        }

        .feature-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 25px 50px rgba(37, 99, 235, 0.15);
        }

        /* Mobile responsive for feature cards */
        @media (max-width: 768px) {
            .feature-card {
                padding: 2rem 1.5rem;
                margin-bottom: 1.5rem;
                border-radius: 16px;
            }
            
            .feature-card:hover {
                transform: translateY(-5px);
            }
        }

        @media (max-width: 576px) {
            .feature-card {
                padding: 1.5rem 1rem;
                text-align: center;
            }
        }

        .feature-icon {
            width: 80px;
            height: 80px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.5rem;
            font-size: 2.2rem;
            color: white;
            position: relative;
        }

        /* Mobile responsive for feature icons */
        @media (max-width: 768px) {
            .feature-icon {
                width: 70px;
                height: 70px;
                font-size: 2rem;
                margin: 0 auto 1.5rem;
            }
        }

        @media (max-width: 576px) {
            .feature-icon {
                width: 60px;
                height: 60px;
                font-size: 1.8rem;
                border-radius: 16px;
            }
        }

        .feature-icon.reports {
            background: var(--gradient-1);
        }

        .feature-icon.digital-signature {
            background: var(--gradient-orange);
        }

        .feature-icon.history {
            background: var(--gradient-green);
        }

        .feature-icon.risk-assessment {
            background: var(--gradient-3);
        }

        .feature-icon.extinguisher-control {
            background: var(--gradient-2);
        }

        .feature-icon.planning {
            background: var(--gradient-purple);
        }

        .feature-card h3 {
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--dark);
            margin-bottom: 1rem;
        }

        .feature-card p {
            color: var(--gray);
            line-height: 1.7;
            margin-bottom: 0;
        }

        /* Planes y Precios */
        .pricing-section {
            background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        }

        .pricing-card {
            background: white;
            border-radius: 24px;
            padding: 3rem 2rem;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            height: 100%;
            margin-bottom: 2rem;
        }

        .pricing-card.popular {
            transform: scale(1.05);
            border: 3px solid var(--primary);
        }

        .pricing-card.popular::before {
            content: 'Más Popular';
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            background: var(--primary);
            color: white;
            padding: 0.5rem 2rem;
            border-radius: 0 0 12px 12px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .pricing-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 60px rgba(0,0,0,0.15);
        }

        .pricing-card.popular:hover {
            transform: translateY(-10px) scale(1.05);
        }

        /* Mobile responsive for pricing cards */
        @media (max-width: 992px) {
            .pricing-card.popular {
                transform: none;
                margin-top: 0;
            }
            
            .pricing-card.popular:hover {
                transform: translateY(-10px);
            }
        }

        @media (max-width: 768px) {
            .pricing-card {
                padding: 2rem 1.5rem;
                border-radius: 20px;
                margin-bottom: 1.5rem;
            }
            
            .pricing-card:hover {
                transform: translateY(-5px);
            }
        }

        @media (max-width: 576px) {
            .pricing-card {
                padding: 1.5rem 1rem;
                text-align: center;
            }
        }

        .price {
            font-size: 3rem;
            font-weight: 800;
            color: var(--primary);
            margin-bottom: 0.5rem;
        }

        .price-period {
            color: var(--gray);
            font-size: 1rem;
            margin-bottom: 2rem;
        }

        .plan-features {
            list-style: none;
            margin-bottom: 2rem;
        }

        .plan-features li {
            padding: 0.75rem 0;
            color: var(--gray);
            position: relative;
            padding-left: 2rem;
        }

        .plan-features li::before {
            content: '✓';
            position: absolute;
            left: 0;
            color: var(--success);
            font-weight: bold;
            font-size: 1.2rem;
        }

        .btn-plan {
            width: 100%;
            padding: 1rem;
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
        }

        .btn-plan.primary {
            background: var(--primary);
            color: white;
        }

        .btn-plan.secondary {
            background: transparent;
            color: var(--primary);
            border: 2px solid var(--primary);
        }

        .btn-plan:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(37, 99, 235, 0.3);
        }

        /* FAQ Section */
        .faq-section {
            background: white;
        }

        .faq-item {
            background: #f8fafc;
            border-radius: 16px;
            margin-bottom: 1rem;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            transition: all 0.3s ease;
        }

        .faq-item:hover {
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }

        .faq-question {
            padding: 1.5rem 2rem;
            cursor: pointer;
            font-weight: 600;
            color: var(--dark);
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s ease;
            user-select: none;
        }

        .faq-question:hover {
            background: #e2e8f0;
            color: var(--primary);
        }

        .faq-answer {
            padding: 0 2rem 1.5rem;
            color: var(--gray);
            line-height: 1.7;
            display: none;
            opacity: 0;
            transition: opacity 0.3s ease;
            max-height: 0;
            overflow: hidden;
        }

        .faq-item.active .faq-answer {
            display: block;
            opacity: 1;
            max-height: 200px;
            transition: opacity 0.3s ease, max-height 0.3s ease;
        }

        .faq-item.active .faq-question {
            background: #e2e8f0;
            color: var(--primary);
        }

        .faq-icon {
            transition: transform 0.3s ease;
            font-size: 1.2rem;
            color: var(--primary);
        }

        .faq-item.active .faq-icon {
            transform: rotate(180deg);
        }

        /* Footer */
        .footer {
            background: var(--dark);
            color: white;
            padding: 3rem 0 1rem;
        }

        .footer h5 {
            color: white;
            margin-bottom: 1rem;
            font-weight: 600;
        }

        .footer ul {
            list-style: none;
        }

        .footer ul li {
            margin-bottom: 0.5rem;
        }

        .footer ul li a {
            color: #9ca3af;
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .footer ul li a:hover {
            color: white;
        }

        .social-links {
            display: flex;
            gap: 1rem;
        }

        .social-link {
            width: 40px;
            height: 40px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .social-link:hover {
            background: var(--primary);
            color: white;
            transform: translateY(-2px);
        }

        /* FAQ Responsive */
        .faq-item {
            background: white;
            border-radius: 12px;
            margin-bottom: 1rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            overflow: hidden;
            transition: all 0.3s ease;
        }

        @media (max-width: 768px) {
            .faq-item {
                margin-bottom: 0.75rem;
                border-radius: 10px;
            }
            
            .faq-question {
                padding: 1rem !important;
                font-size: 1rem !important;
            }
            
            .faq-answer {
                padding: 0 1rem 1rem !important;
                font-size: 0.9rem !important;
                line-height: 1.6 !important;
            }
            
            .faq-icon {
                font-size: 1rem !important;
            }
        }

        @media (max-width: 576px) {
            .faq-question {
                padding: 0.8rem !important;
                font-size: 0.95rem !important;
            }
            
            .faq-answer {
                padding: 0 0.8rem 0.8rem !important;
            }
        }

        /* Footer Responsive */
        @media (max-width: 768px) {
            .footer {
                padding: 2rem 0 1rem;
                text-align: center;
            }
            
            .footer .row > div {
                margin-bottom: 2rem;
            }
            
            .social-links {
                justify-content: center;
                margin-top: 1rem;
            }
            
            .footer ul {
                margin-bottom: 1rem;
            }
        }

        @media (max-width: 576px) {
            .footer h5 {
                font-size: 1.1rem;
            }
            
            .footer ul li {
                margin-bottom: 0.3rem;
            }
            
            .social-link {
                width: 35px;
                height: 35px;
                font-size: 0.9rem;
            }
        }

        /* Scroll animations */
        .scroll-animate {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.6s ease;
        }

        .scroll-animate.visible {
            opacity: 1;
            transform: translateY(0);
        }
    </style>
</head>

<body>
    <!-- Navegación -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>SAT
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="#inicio">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#funcionalidades">Funcionalidades</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#planes">Planes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#faq">FAQ</a>
                    </li>
                    <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <form action="/auth/logout" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Cerrar Sesión</button>
                            </form>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/login">Iniciar Sesión</a>
                        </li>
                        <li class="nav-item">
                            <a href="/auth/register" class="btn btn-primary btn-sm ms-2">Registrarse</a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="inicio" class="hero">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-12 text-center hero-content">
                    <h1>Sistema de Alerta Temprana</h1>
                    <p class="lead">
                        La app que faltaba en Seguridad e Higiene. Relevamientos, informes y controles, incluso sin conexión.
                        Optimiza tu tiempo en cada visita y accede a todo tu historial.
                    </p>
                    <div class="mt-4">
                        <a href="/auth/register" class="btn-custom btn-primary-custom">
                            <i class="bi bi-rocket-takeoff me-2"></i>Comenzar Ahora
                        </a>
                        <a href="#funcionalidades" class="btn-custom btn-secondary-custom">
                            <i class="bi bi-play-circle me-2"></i>Ver Demo
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Estadísticas -->
    <section class="stats-section">
        <div class="container">
            <div class="row">
                <div class="col-lg-3 col-md-6 col-sm-6 col-12 mb-4">
                    <div class="stat-card scroll-animate">
                        <span class="stat-number">300+</span>
                        <span class="stat-label">Empresas Activas</span>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-sm-6 col-12 mb-4">
                    <div class="stat-card scroll-animate">
                        <span class="stat-number">15,000+</span>
                        <span class="stat-label">Relevamientos Realizados</span>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-sm-6 col-12 mb-4">
                    <div class="stat-card scroll-animate">
                        <span class="stat-number">99%</span>
                        <span class="stat-label">Disponibilidad Offline</span>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-sm-6 col-12 mb-4">
                    <div class="stat-card scroll-animate">
                        <span class="stat-number">24/7</span>
                        <span class="stat-label">Sincronización</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Funcionalidades -->
    <section id="funcionalidades" class="section">
        <div class="container">
            <div class="section-title scroll-animate">
                <h2>Funcionalidades Principales</h2>
                <p>Descubre todas las herramientas que SAT te ofrece para optimizar tu trabajo en Seguridad e Higiene</p>
            </div>
            
            <div class="row">
                <div class="col-lg-4 col-md-6 col-12 mb-4">
                    <div class="feature-card scroll-animate">
                        <div class="feature-icon reports">
