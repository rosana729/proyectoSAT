<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'SAT - Sistema de Administración de Extintores' %></title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    
    <!-- Meta tags para SEO y PWA -->
    <meta name="description" content="Sistema de Administración de Extintores - Gestión y seguimiento de equipos contra incendios">
    <meta name="keywords" content="extintores, mantenimiento, inspección, seguridad, prevención de incendios">
    <meta name="author" content="SAT Project Team">
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= process.env.BASE_URL || 'http://localhost:3000' %>">
    <meta property="og:title" content="<%= title || 'SAT - Sistema de Administración de Extintores' %>">
    <meta property="og:description" content="Sistema de Administración de Extintores - Gestión y seguimiento de equipos contra incendios">
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:title" content="<%= title || 'SAT - Sistema de Administración de Extintores' %>">
    <meta property="twitter:description" content="Sistema de Administración de Extintores - Gestión y seguimiento de equipos contra incendios">
</head>
<body>
    <!-- Header -->
    <%- include('../partials/header') %>
    
    <!-- Navigation -->
    <%- include('../partials/navbar') %>
    
    <!-- Main Content -->
    <main class="main-content">
        <!-- Flash Messages -->
        <% if (typeof messages !== 'undefined') { %>
            <% if (messages.success && messages.success.length > 0) { %>
                <div class="container mt-3">
                    <% messages.success.forEach(function(message) { %>
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <%= message %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% }); %>
                </div>
            <% } %>
            
            <% if (messages.error && messages.error.length > 0) { %>
                <div class="container mt-3">
                    <% messages.error.forEach(function(message) { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <%= message %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% }); %>
                </div>
            <% } %>
            
            <% if (messages.info && messages.info.length > 0) { %>
                <div class="container mt-3">
                    <% messages.info.forEach(function(message) { %>
                        <div class="alert alert-info alert-dismissible fade show" role="alert">
                            <i class="bi bi-info-circle-fill me-2"></i>
                            <%= message %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% }); %>
                </div>
            <% } %>
            
            <% if (messages.warning && messages.warning.length > 0) { %>
                <div class="container mt-3">
                    <% messages.warning.forEach(function(message) { %>
                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <%= message %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        <% } %>
        
        <!-- Page Content -->
        <%- body %>
    </main>
    
    <!-- Footer -->
    <%- include('../partials/footer') %>
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom JS -->
    <script src="/js/main.js"></script>
    
    <!-- Additional Scripts -->
    <% if (typeof scripts !== 'undefined' && scripts.length > 0) { %>
        <% scripts.forEach(function(script) { %>
            <script src="<%= script %>"></script>
        <% }); %>
    <% } %>
</body>
</html>