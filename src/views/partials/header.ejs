<!-- Header superior con información de la aplicación -->
<header class="top-header bg-primary text-white py-2">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <div class="d-flex align-items-center">
                    <i class="bi bi-shield-fill-check me-2 fs-4"></i>
                    <div>
                        <h6 class="mb-0 fw-bold">SAT</h6>
                        <small class="opacity-75">Sistema de Administración de Extintores</small>
                    </div>
                </div>
            </div>
            <div class="col-md-6 text-md-end">
                <% if (typeof user !== 'undefined' && user) { %>
                    <span class="me-3">
                        <i class="bi bi-person-circle me-1"></i>
                        Bienvenido, <strong><%= user.full_name %></strong>
                    </span>
                    <span class="badge bg-light text-primary">
                        <i class="bi bi-shield-check me-1"></i>
                        <%= user.role === 'admin' ? 'Administrador' : 'Usuario' %>
                    </span>
                <% } else { %>
                    <span class="opacity-75">
                        <i class="bi bi-info-circle me-1"></i>
                        Sistema de gestión y seguimiento de extintores
                    </span>
                <% } %>
            </div>
        </div>
    </div>
</header>