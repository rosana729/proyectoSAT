<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro - Sistema SAT</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    
    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #06b6d4;
            --light: #f8fafc;
            --dark: #1e293b;
            --gray: #64748b;
        }

        body {
            background: linear-gradient(135deg, var(--primary) 0%, #7c3aed 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .register-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px 0;
        }

        .register-card {
            background: white;
            border-radius: 24px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
            padding: 0;
            overflow: hidden;
            max-width: 500px;
            width: 100%;
            animation: slideInUp 0.8s ease-out;
        }

        .register-header {
            background: linear-gradient(135deg, var(--primary) 0%, #7c3aed 100%);
            color: white;
            padding: 2rem;
            text-align: center;
        }

        .register-header h1 {
            font-size: 1.8rem;
            font-weight: 700;
            margin: 0;
        }

        .register-header p {
            margin: 0.5rem 0 0 0;
            opacity: 0.9;
            font-size: 0.95rem;
        }

        .register-body {
            padding: 2rem;
        }

        .form-floating {
            margin-bottom: 1rem;
        }

        .form-floating > label {
            font-weight: 500;
            color: var(--gray);
        }

        .form-control {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 0.75rem 1rem;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        .form-select {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 0.75rem 1rem;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }

        .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border: none;
            border-radius: 12px;
            padding: 0.75rem 2rem;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
            width: 100%;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(37, 99, 235, 0.4);
        }

        .password-toggle {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--gray);
            cursor: pointer;
            z-index: 10;
        }

        .password-strength {
            height: 4px;
            border-radius: 2px;
            background: #e2e8f0;
            overflow: hidden;
            margin-top: 0.5rem;
        }

        .password-strength-bar {
            height: 100%;
            transition: all 0.3s ease;
            border-radius: 2px;
        }

        .strength-weak { background: var(--danger); }
        .strength-fair { background: var(--warning); }
        .strength-good { background: var(--info); }
        .strength-strong { background: var(--success); }

        .form-check-input:checked {
            background-color: var(--primary);
            border-color: var(--primary);
        }

        .alert {
            border-radius: 12px;
            border: none;
            padding: 1rem 1.25rem;
            margin-bottom: 1.5rem;
        }

        .demo-credentials {
            background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
            border-radius: 12px;
            padding: 1rem;
            margin-bottom: 1.5rem;
            border: 1px solid #f59e0b;
        }

        .demo-credentials h6 {
            color: #92400e;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .demo-credentials small {
            color: #a16207;
        }

        .benefits {
            background: var(--light);
            border-radius: 12px;
            padding: 1.5rem;
            margin-top: 2rem;
        }

        .benefit-item {
            display: flex;
            align-items: center;
            margin-bottom: 0.75rem;
        }

        .benefit-item:last-child {
            margin-bottom: 0;
        }

        .benefit-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 0.75rem;
            font-size: 0.9rem;
        }

        .benefit-icon.security {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success);
        }

        .benefit-icon.instant {
            background: rgba(6, 182, 212, 0.1);
            color: var(--info);
        }

        .benefit-icon.support {
            background: rgba(245, 158, 11, 0.1);
            color: var(--warning);
        }

        @keyframes slideInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .login-link {
            text-align: center;
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid #e2e8f0;
        }

        .login-link a {
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
        }

        .login-link a:hover {
            text-decoration: underline;
        }

        /* Loading spinner */
        .btn-loading {
            position: relative;
            pointer-events: none;
        }

        .btn-loading .btn-text {
            opacity: 0;
        }

        .loading-spinner {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        @media (max-width: 576px) {
            .register-card {
                margin: 20px;
                border-radius: 16px;
            }
            
            .register-header {
                padding: 1.5rem;
            }
            
            .register-body {
                padding: 1.5rem;
            }
        }
    </style>
</head>

<body>
    <div class="register-container">
        <div class="register-card">
            <!-- Header -->
            <div class="register-header">
                <div class="mb-3">
                    <i class="bi bi-shield-fill-check" style="font-size: 2.5rem;"></i>
                </div>
                <h1>Crear Cuenta</h1>
                <p>Únete al Sistema SAT y gestiona tus extintores</p>
            </div>

            <!-- Body -->
            <div class="register-body">
                <!-- Información Demo -->
                <div class="demo-credentials">
                    <h6><i class="bi bi-info-circle me-2"></i>Cuentas de Demo Disponibles</h6>
                    <small>
                        <strong>Admin:</strong> admin@sat.com / admin123<br>
                        <strong>Técnico:</strong> tecnico@sat.com / tecnico123<br>
                        <strong>Manager:</strong> manager@sat.com / manager123
                    </small>
                </div>

                <!-- Mensajes de error/éxito -->
                <% if (typeof messages !== 'undefined' && messages.error) { %>
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <%= messages.error %>
                    </div>
                <% } %>

                <% if (typeof messages !== 'undefined' && messages.success) { %>
                    <div class="alert alert-success">
                        <i class="bi bi-check-circle me-2"></i>
                        <%= messages.success %>
                    </div>
                <% } %>

                <!-- Formulario -->
                <form action="/auth/register" method="POST" id="registerForm" novalidate>
                    <!-- Nombre y Apellido -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input 
                                    type="text" 
                                    class="form-control" 
                                    id="firstName" 
                                    name="firstName" 
                                    placeholder="Tu nombre"
                                    required
                                    value="<%= typeof formData !== 'undefined' ? formData.firstName || '' : '' %>"
                                >
                                <label for="firstName"><i class="bi bi-person me-2"></i>Nombre</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input 
                                    type="text" 
                                    class="form-control" 
                                    id="lastName" 
                                    name="lastName" 
                                    placeholder="Tu apellido"
                                    required
                                    value="<%= typeof formData !== 'undefined' ? formData.lastName || '' : '' %>"
                                >
                                <label for="lastName"><i class="bi bi-person me-2"></i>Apellido</label>
                            </div>
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="form-floating">
                        <input 
                            type="email" 
                            class="form-control" 
                            id="email" 
                            name="email" 
                            placeholder="tu@email.com"
                            required
                            value="<%= typeof formData !== 'undefined' ? formData.email || '' : '' %>"
                        >
                        <label for="email"><i class="bi bi-envelope me-2"></i>Email</label>
                    </div>

                    <!-- Rol -->
                    <div class="mb-3">
                        <label for="role" class="form-label"><i class="bi bi-briefcase me-2"></i>Rol en la Organización</label>
                        <select class="form-select" id="role" name="role" required>
                            <option value="">Selecciona tu rol</option>
                            <option value="admin" <%= typeof formData !== 'undefined' && formData.role === 'admin' ? 'selected' : '' %>>Administrador</option>
                            <option value="manager" <%= typeof formData !== 'undefined' && formData.role === 'manager' ? 'selected' : '' %>>Supervisor/Manager</option>
                            <option value="technician" <%= typeof formData !== 'undefined' && formData.role === 'technician' ? 'selected' : '' %>>Técnico</option>
                            <option value="viewer" <%= typeof formData !== 'undefined' && formData.role === 'viewer' ? 'selected' : '' %>>Visualizador</option>
                        </select>
                    </div>

                    <!-- Organización -->
                    <div class="form-floating">
                        <input 
                            type="text" 
                            class="form-control" 
                            id="organization" 
                            name="organization" 
                            placeholder="Nombre de tu empresa u organización"
                            value="<%= typeof formData !== 'undefined' ? formData.organization || '' : '' %>"
                        >
                        <label for="organization"><i class="bi bi-building me-2"></i>Organización (Opcional)</label>
                    </div>

                    <!-- Contraseña -->
                    <div class="form-floating position-relative">
                        <input 
                            type="password" 
                            class="form-control" 
                            id="password" 
                            name="password" 
                            placeholder="Mínimo 8 caracteres"
                            required
                        >
                        <label for="password"><i class="bi bi-lock me-2"></i>Contraseña</label>
                        <button type="button" class="password-toggle" id="togglePassword">
                            <i class="bi bi-eye" id="toggleIcon"></i>
                        </button>
                    </div>

                    <!-- Indicador de fortaleza -->
                    <div class="password-strength">
                        <div class="password-strength-bar" id="strengthBar"></div>
                    </div>
                    <small class="text-muted" id="strengthText">Ingresa una contraseña segura</small>

                    <!-- Confirmar Contraseña -->
                    <div class="form-floating mt-3">
                        <input 
                            type="password" 
                            class="form-control" 
                            id="confirmPassword" 
                            name="confirmPassword" 
                            placeholder="Repite tu contraseña"
                            required
                        >
                        <label for="confirmPassword"><i class="bi bi-lock-fill me-2"></i>Confirmar Contraseña</label>
                    </div>

                    <!-- Términos y Condiciones -->
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="termsAccepted" name="termsAccepted" required>
                        <label class="form-check-label" for="termsAccepted">
                            Acepto los <a href="/terms" target="_blank">Términos y Condiciones</a> y la <a href="/privacy" target="_blank">Política de Privacidad</a>
                        </label>
                    </div>

                    <!-- Newsletter -->
                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="newsletter" name="newsletter">
                        <label class="form-check-label" for="newsletter">
                            Quiero recibir actualizaciones y noticias sobre SAT por email
                        </label>
                    </div>

                    <!-- Botón Submit -->
                    <button type="submit" class="btn btn-primary" id="submitBtn">
                        <span class="btn-text">
                            <i class="bi bi-person-plus me-2"></i>Crear Cuenta
                        </span>
                        <div class="loading-spinner d-none">
                            <div class="spinner-border spinner-border-sm text-white"></div>
                        </div>
                    </button>
                </form>

                <!-- Beneficios -->
                <div class="benefits">
                    <div class="benefit-item">
                        <div class="benefit-icon security">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div>
                            <strong>100% Seguro</strong><br>
                            <small class="text-muted">Tus datos están protegidos</small>
                        </div>
                    </div>
                    <div class="benefit-item">
                        <div class="benefit-icon instant">
                            <i class="bi bi-clock"></i>
                        </div>
                        <div>
                            <strong>Acceso Inmediato</strong><br>
                            <small class="text-muted">Comienza a usar SAT ahora</small>
                        </div>
                    </div>
                    <div class="benefit-item">
                        <div class="benefit-icon support">
                            <i class="bi bi-headset"></i>
                        </div>
                        <div>
                            <strong>Soporte 24/7</strong><br>
                            <small class="text-muted">Ayuda cuando la necesites</small>
                        </div>
                    </div>
                </div>

                <!-- Link a Login -->
                <div class="login-link">
                    <span class="text-muted">¿Ya tienes cuenta? </span>
                    <a href="/auth/login">Inicia sesión aquí</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('registerForm');
            const submitBtn = document.getElementById('submitBtn');
            const togglePassword = document.getElementById('togglePassword');
            const passwordInput = document.getElementById('password');
            const confirmPasswordInput = document.getElementById('confirmPassword');
            const toggleIcon = document.getElementById('toggleIcon');
            const strengthBar = document.getElementById('strengthBar');
            const strengthText = document.getElementById('strengthText');

            // Toggle password visibility
            togglePassword.addEventListener('click', function() {
                const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordInput.setAttribute('type', type);
                confirmPasswordInput.setAttribute('type', type);
                toggleIcon.className = type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
            });

            // Password strength checker
            passwordInput.addEventListener('input', function() {
                const password = this.value;
                updatePasswordStrength(password);
            });

            function updatePasswordStrength(password) {
                let strength = 0;
                let message = '';
                let colorClass = '';

                if (password.length >= 8) strength++;
                if (/[A-Z]/.test(password)) strength++;
                if (/[a-z]/.test(password)) strength++;
                if (/\d/.test(password)) strength++;
                if (/[!@#$%^&*(),.?":{}|<>]/.test(password)) strength++;

                const percentage = (strength / 5) * 100;

                switch (strength) {
                    case 0:
                    case 1:
                        message = 'Muy débil';
                        colorClass = 'strength-weak';
                        break;
                    case 2:
                        message = 'Débil';
                        colorClass = 'strength-fair';
                        break;
                    case 3:
                        message = 'Moderada';
                        colorClass = 'strength-good';
                        break;
                    case 4:
                    case 5:
                        message = 'Fuerte';
                        colorClass = 'strength-strong';
                        break;
                }

                strengthBar.style.width = percentage + '%';
                strengthBar.className = `password-strength-bar ${colorClass}`;
                strengthText.textContent = message;
            }

            // Form validation
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                
                // Basic validation
                const firstName = document.getElementById('firstName').value.trim();
                const lastName = document.getElementById('lastName').value.trim();
                const email = document.getElementById('email').value.trim();
                const role = document.getElementById('role').value;
                const password = document.getElementById('password').value;
                const confirmPassword = document.getElementById('confirmPassword').value;
                const termsAccepted = document.getElementById('termsAccepted').checked;

                if (!firstName || !lastName || !email || !role || !password || !confirmPassword || !termsAccepted) {
                    showAlert('danger', 'Por favor completa todos los campos requeridos');
                    return;
                }

                if (password !== confirmPassword) {
                    showAlert('danger', 'Las contraseñas no coinciden');
                    return;
                }

                if (password.length < 8) {
                    showAlert('danger', 'La contraseña debe tener al menos 8 caracteres');
                    return;
                }

                // Show loading
                showLoading();

                // Submit form
                const formData = new FormData(form);
                submitForm(formData);
            });

            function showLoading() {
                submitBtn.classList.add('btn-loading');
                submitBtn.querySelector('.btn-text').style.opacity = '0';
                submitBtn.querySelector('.loading-spinner').classList.remove('d-none');
                submitBtn.disabled = true;
            }

            function hideLoading() {
                submitBtn.classList.remove('btn-loading');
                submitBtn.querySelector('.btn-text').style.opacity = '1';
                submitBtn.querySelector('.loading-spinner').classList.add('d-none');
                submitBtn.disabled = false;
            }

            async function submitForm(formData) {
                try {
                    const response = await fetch('/auth/register', {
                        method: 'POST',
                        body: formData
                    });

                    if (response.ok) {
                        showAlert('success', '¡Cuenta creada exitosamente! Redirigiendo...');
                        setTimeout(() => {
                            window.location.href = '/dashboard';
                        }, 2000);
                    } else {
                        const data = await response.text();
                        showAlert('danger', 'Error al crear la cuenta. Inténtalo de nuevo.');
                        hideLoading();
                    }
                } catch (error) {
                    console.error('Error:', error);
                    showAlert('danger', 'Error de conexión. Inténtalo de nuevo.');
                    hideLoading();
                }
            }

            function showAlert(type, message) {
                // Remove existing alerts
                const existingAlerts = document.querySelectorAll('.alert');
                existingAlerts.forEach(alert => {
                    if (!alert.classList.contains('demo-credentials')) {
                        alert.remove();
                    }
                });

                // Create new alert
                const alertDiv = document.createElement('div');
                alertDiv.className = `alert alert-${type}`;
                alertDiv.innerHTML = `
                    <i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-triangle'} me-2"></i>
                    ${message}
                `;
                
                // Insert after demo credentials
                const demoDiv = document.querySelector('.demo-credentials');
                demoDiv.parentNode.insertBefore(alertDiv, demoDiv.nextSibling);
                
                // Auto remove after 5 seconds
                setTimeout(() => {
                    alertDiv.remove();
                }, 5000);
            }
        });
    </script>
</body>
</html>